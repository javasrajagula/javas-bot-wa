# Database Configuration
# Use SQLite for easy development, or PostgreSQL for production
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
NODE_ENV="development"
LOG_LEVEL="info"

# WhatsApp Bot Settings
BOT_PREFIX="/"
ADAPTER_MODE="console" # Options: "console", "baileys"
WA_SESSION_NAME="wa-session"

# Queue Configuration
USE_REDIS="false" # Set to "true" to use BullMQ/Redis in production
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"

# External API Keys (Optional fallbacks / production features)
# Replicate API token for advanced HD image upscaling
REPLICATE_API_TOKEN=""

# Downloader Cookies (Optional, if scraping requires authentication)
TIKTOK_COOKIES=""
INSTAGRAM_COOKIES=""

# Bot Owner Configuration
# Comma-separated list of WhatsApp phone numbers (without JID extension)
OWNER_IDS=""

# Owner Web Dashboard
# Dashboard only starts when DASHBOARD_ENABLED=true and password is set.
DASHBOARD_ENABLED="false"
DASHBOARD_HOST="127.0.0.1" # default to local binding in production/development
DASHBOARD_PORT="8787"
OWNER_DASHBOARD_PASSWORD="" # Required when DASHBOARD_ENABLED=true
OWNER_PASSWORD="" # Fallback dashboard password if OWNER_DASHBOARD_PASSWORD is not set
DASHBOARD_API_ENABLED="false"
DASHBOARD_API_KEY=""

# Backup & Restore
AUTO_BACKUP_ENABLED="true"
BACKUP_RETENTION_DAYS="14"

# Non-paid utility engines
# OCR_COMMAND should point to local Tesseract executable.
OCR_COMMAND="tesseract"
# STT_COMMAND should point to a local Whisper/Vosk wrapper that accepts an audio file path and prints text to stdout.
STT_COMMAND=""
# Optional self-hosted LibreTranslate endpoint, e.g. http://localhost:5000
LIBRETRANSLATE_URL=""

# Optional AI provider abstraction for future AI commands.
AI_PROVIDER="none"
AI_API_BASE_URL=""
AI_API_KEY=""
PUBLIC_BASE_URL=""

# Rate Limiting Bypass Settings
OWNER_BYPASS_RATE_LIMIT="true" # Set to "true" to allow owner IDs to bypass rate limits
PRIVATE_CHAT_BYPASS_RATE_LIMIT="true" # Set to "true" to allow private chats to bypass rate limits

# Remove Background Settings
REMOVEBG_PROVIDER="none" # Options: "none", "api", "local"
REMOVEBG_API_KEY="" # Required if REMOVEBG_PROVIDER="api"
REMOVEBG_COMMAND="" # Required if REMOVEBG_PROVIDER="local", e.g., "rembg i"

# Sticker Metadata Settings
STICKER_PACK_NAME="Javas Bot WA"
STICKER_AUTHOR_NAME="bot wa javas"

# Watermark Font Settings
FONT_FILE_PATH="" # Optional path to TTF/OTF font file for drawing watermark text on video

# OCR, STT & TTS Engine Settings
TESSERACT_CMD="tesseract"
OCR_TIMEOUT_SECONDS="60"
STT_TIMEOUT_SECONDS="120"
TTS_PROVIDER="google"
TTS_COMMAND=""
TTS_API_BASE_URL=""
TTS_API_KEY=""

# Quota & Payment Configuration
PRIVATE_DAILY_CMD_LIMIT="20"
PREMIUM_PRIVATE_DAILY_CMD_LIMIT="200"
PREMIUM_PAYMENT_METHOD="GoPay"
PREMIUM_PAYMENT_NUMBER="085338123425"

