datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GroupConfig {
  id             String   @id @default(uuid())
  groupId        String   @unique
  prefix         String   @default("/")
  botEnabled     Boolean  @default(true)
  featuresJson   String   @default("{}")
  welcomeMessage String?
  goodbyeMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  language     String    @default("id")
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  title        String?
  badgesJson   String    @default("[]")
  cardBgUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String
  groupId   String?
  feature   String
  command   String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PremiumUser {
  id        String   @id @default(uuid())
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Warning {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  reason    String?
  warnedBy  String?
  createdAt DateTime @default(now())
}

model Badword {
  id        String   @id @default(uuid())
  groupId   String
  word      String
  createdBy String?
  createdAt DateTime @default(now())
}

model Blacklist {
  id        String   @id @default(uuid())
  scope     String   @default("group") // "group" or "global"
  groupId   String?
  userId    String
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

model AutoReply {
  id        String   @id @default(uuid())
  groupId   String
  trigger   String
  response  String
  matchType String   @default("exact") // "exact" or "contains"
  createdBy String?
  createdAt DateTime @default(now())
}

model Poll {
  id          String    @id @default(uuid())
  groupId     String
  question    String
  optionsJson String
  votesJson   String
  status      String    @default("active") // "active" or "closed"
  createdBy   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model Reminder {
  id        String   @id @default(uuid())
  scope     String   @default("private") // "private" or "group"
  groupId   String?
  userId    String
  message   String
  runAt     DateTime
  timezone  String   @default("Asia/Jakarta")
  status    String   @default("pending") // "pending" or "sent"
  createdAt DateTime @default(now())
}

model AttendanceSession {
  id               String    @id @default(uuid())
  groupId          String
  title            String
  status           String    @default("open") // "open" or "closed"
  participantsJson String    @default("[]")
  createdBy        String?
  createdAt        DateTime  @default(now())
  closedAt         DateTime?
}

model GameSession {
  id          String    @id @default(uuid())
  groupId     String    @unique
  gameType    String
  status      String    // "lobby", "playing", "finished"
  playersJson String
  stateJson   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?
}

model GameStats {
  id           String   @id @default(uuid())
  userId       String
  groupId      String?
  gameType     String
  wins         Int      @default(0)
  losses       Int      @default(0)
  points       Int      @default(0)
  metadataJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model UserEconomy {
  id          String    @id @default(uuid())
  userId      String    @unique
  balance     Int       @default(0)
  bank        Int       @default(0)
  xp          Int       @default(0)
  level       Int       @default(1)
  lastClaim   DateTime?
  lastWork    DateTime?
  lastMining  DateTime?
  lastFishing DateTime?
  lastCrime   DateTime?
  lastRob     DateTime?
  claimStreak Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ShopItem {
  id           String   @id @default(uuid())
  name         String   @unique
  type         String
  price        Int
  metadataJson String   @default("{}")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model UserInventory {
  id           String   @id @default(uuid())
  userId       String
  itemId       String
  quantity     Int      @default(1)
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
}

model Pet {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String
  type         String
  level        Int      @default(1)
  xp           Int      @default(0)
  hunger       Int      @default(100)
  metadataJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  keyHash   String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model ErrorLog {
  id           String   @id @default(uuid())
  errorId      String?  @unique
  scope        String?
  feature      String?
  message      String
  stack        String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
}

model BotSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  valueJson String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PluginState {
  id        String   @id @default(uuid())
  name      String   @unique
  enabled   Boolean  @default(true)
  stateJson String   @default("{}")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  groupId      String?
  action       String
  target       String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
}

model ErrorRecord {
  id           String   @id @default(uuid())
  errorId      String   @unique
  scope        String?
  feature      String?
  status       String   @default("open")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
}

model QueueJobRecord {
  id           String   @id @default(uuid())
  jobId        String   @unique
  queue        String
  status       String
  command      String?
  groupId      String?
  userId       String?
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime?
}

model CommandAlias {
  id        String   @id @default(uuid())
  groupId   String?
  alias     String
  command   String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([groupId, alias])
}

model CustomVariable {
  id        String   @id @default(uuid())
  groupId   String?
  userId    String?
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId, key])
}

model Webhook {
  id        String   @id @default(uuid())
  groupId   String?
  url       String
  eventsJson String @default("[]")
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BroadcastTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataRetentionPolicy {
  id        String   @id @default(uuid())
  groupId   String?
  scope     String
  duration  String
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrdStateRecord {
  id           String   @id @default(uuid())
  type         String
  scope        String
  ownerId      String?
  status       String   @default("active")
  text         String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, scope])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model GroupSubscription {
  id          String   @id @default(uuid())
  groupId     String   @unique
  plan        String   @default("free")
  expiresAt   DateTime?
  maxDailyCmd Int?
  featuresJson String  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WarningRule {
  id        String   @id @default(uuid())
  groupId   String
  threshold Int
  action    String
  duration  Int?
  createdAt DateTime @default(now())
}

model InfractionLog {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  type      String
  reason    String?
  action    String?
  createdBy String?
  createdAt DateTime @default(now())
}

model GroupLog {
  id          String   @id @default(uuid())
  groupId     String
  userId      String?
  type        String
  action      String?
  message     String?
  metadataJson String @default("{}")
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  groupId     String
  userId      String
  description String
  deadline    DateTime?
  status      String   @default("pending") // "pending" or "done"
  createdAt   DateTime @default(now())
}

model Schedule {
  id          String   @id @default(uuid())
  groupId     String
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  time        String   // "HH:MM" format
  subject     String
  createdAt   DateTime @default(now())
}

model Birthday {
  id          String   @id @default(uuid())
  groupId     String
  userId      String
  date        String   // "MM-DD" format
  createdAt   DateTime @default(now())
}

model EconomyTransaction {
  id           String   @id @default(uuid())
  userId       String
  groupId      String?
  type         String
  amount       Int
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
}

model RedeemCode {
  id         String    @id @default(uuid())
  code       String    @unique
  rewardJson String
  maxUses    Int
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model MarketListing {
  id        String   @id @default(uuid())
  sellerId  String
  itemId    String
  price     Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  rarity      String   // "common" | "rare" | "epic" | "legendary"
  rewardJson  String   @default("{}") // e.g. {"balance": 1000, "badge": "🏆", "title": "Rich"}
  createdAt   DateTime @default(now())
}

model UserAchievement {
  id             String   @id @default(uuid())
  userId         String
  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
}
